# Data (never committed). Anchored to the repo root: an unanchored `data/`
# also matches `src/data/`, which is a DIFFERENT thing -- the loader/windows
# source package, not the dataset -- and silently excludes it from every
# commit. That happened here; see the note left for the team.
/data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Notebooks
.ipynb_checkpoints/

# Tooling / OS
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

# Diagnostic plots: 546 per-session PNGs regenerated by
# `python -m data.sanity`. Kept out of version control as noise; the
# summary reports and the headline figure ARE tracked.
results/sanity/trajectory/
results/sanity/signals/
results/sanity/xcorr/

# Per-outage scoring rows (17 MB). Regenerate with
# `python -m eval.final_scoring`; the aggregated tables in
# final_scoring.md are tracked.
results/final_scoring.csv

# Model checkpoints (15 MB each). Reproduce with `python -m train`.
results/training/*.pt
